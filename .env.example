# 示例值；主程序不自动读取 .env，运行前显式导入或通过 systemd EnvironmentFile 加载。
HOST=127.0.0.1
PORT=8080
VENUE_CONFIG=examples/venues/liangzhu.json
WISHSTONE_DATA_DIR=app
# 必须替换为手机能访问的稳定地址；本地预览可以留空。
PUBLIC_BASE_URL=
# 配置本项目的 SenseVoice 适配服务，或实现相同协议的其他 ASR。
ASR_HTTP_URL=http://127.0.0.1:8091/transcribe
ASR_TIMEOUT_SECONDS=120
ASR_THREADS=2
ASR_LANGUAGE=zh
SENSEVOICE_MODEL_DIR=models/sensevoice
# 留空则关闭相应管理/硬件确认入口。部署时自行生成，不要提交到仓库。
ADMIN_TOKEN=
DEVICE_TOKEN=
ASR_API_TOKEN=
# 树莓派使用 BCM 编号；按钮接 GPIO17 与 GND。
BUTTON_GPIO=17
PN532_REQ_GPIO=12
PN532_RESET_GPIO=6
# STATUS_LED_GPIO=27
# AUDIO_INPUT_DEVICE=1
# VENUE_ID=venue-liangzhu
# DEVICE_ID=device-demo-001
WISHSTONE_API_URL=http://127.0.0.1:8080
